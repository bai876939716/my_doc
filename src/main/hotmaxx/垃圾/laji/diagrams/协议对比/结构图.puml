@startuml MCP_Transport_Layer
skinparam component {
  BackgroundColor #f0f8ff
}
component "MCP 上层协议\n(JSON-RPC消息语义：initialize、tools/call)" as MCP
component "Transport选项1：Streamable HTTP【新版推荐】" as STREAM
component "Transport选项2：旧版 HTTP+SSE【废弃】" as OLD_SSE
component "Transport选项3：stdio（本地进程管道）" as STDIO
component "HTTP 标准协议" as HTTP
component "SSE（Server-Sent Events，HTTP上的单向流）" as SSE

MCP --> STREAM : 选用
MCP --> OLD_SSE : 旧版本选用
MCP --> STDIO : 本地客户端(Cursor/Claude Desktop)
STREAM --> HTTP : 基于HTTP POST
STREAM ..> SSE : 按需、可选启用SSE
OLD_SSE --> HTTP : 基于HTTP
OLD_SSE --> SSE : 强制常驻SSE长连接
SSE --> HTTP : SSE是HTTP的子集能力
@enduml
