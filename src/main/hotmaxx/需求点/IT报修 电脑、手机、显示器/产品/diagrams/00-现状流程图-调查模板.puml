@startuml 00-现状流程图-调查模板
!theme plain
skinparam backgroundColor #FAFAFA
skinparam defaultFontName "PingFang SC,Microsoft YaHei,Arial"
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityBorderColor #90A4AE
skinparam ActivityDiamondBackgroundColor #FFFDE7
skinparam ActivityDiamondBorderColor #E0C96B
skinparam ArrowColor #607D8B
skinparam NoteBackgroundColor #FFFDE7
skinparam NoteBorderColor #E0C96B
skinparam PartitionBackgroundColor #FAFAFA
skinparam PartitionBorderColor #B0BEC5

title 门店电脑报修 · 现状流程调查模板（访谈时逐项填空；已确认的路径改实线，没发现的卡点删掉）

legend left
  填写约定
  【__】= 待填的事实
  ⚠ = 预设卡点，未发现就删
  右侧黄框 = 要额外确认的隐性路径
endlegend

start
:👤 电脑出现故障;

if (影响营业吗？收银 / 开单停摆) then (是，紧急)
  note right
    ⚠ 加急路径是否存在：
    直接打电话 / 发微信找运维或店长【__】
    频率【__】
  end note
else (否)
endif

:👤 填写报修表单
表单载体【__】
⚠ 常不会填 / 乱填的字段【__】;
note right
  填写耗时【__】
  表单之外的补救动作
  （拍照发群、找人代填）【__】
end note

:👤 提交后等待受理
典型耗时【__】最差【__】;
note right
  ⚠ 等待期间催单：
  催谁【__】怎么催【__】频率【__】
end note

partition "运维" {
  :⚙ 收到报修
  查看工具（表格 / 群 / 系统）【__】;
  while (信息齐全、序列号正确？) is (否)
    :⚙ 联系门店补信息
    渠道【__】每次耗时【__】;
  endwhile (是)
  :⚙ 判断供应商
    依据（序列号 / 品牌 / 区域 / 合同）【__】
    ⚠ 规则是成文还是凭经验【__】;
  :⚙ 联系供应商
    方式（电话 / 微信 / 邮件）【__】
    怎么确认对方接单【__】;
}

partition "供应商" {
  :🔧 接单响应
  合同时限【__】实际响应【__】;
  if (处理方式) then (远程)
  else (到店)
    :🔧 上门维修
    到店时效【__】;
  endif
  while (修好了吗？) is (否)
    note right
      ⚠ 修不好的频率【__】
      换件 / 换机 / 二次派单由谁决定【__】
    end note
  endwhile (是)
  :🔧 回报完成
  回报给谁【__】怎么回报【__】;
}

partition "闭环与结算" {
  if (有人确认修好了吗？) then (没有)
    :⚠ 闭环缺失，口头默认修好;
  else (有)
    :👤 门店确认修复
    谁来确认【__】;
  endif
  if (门店损坏、需要门店承担费用？) then (是)
    :🔧 供应商报价给运维;
    :⚙ 运维核价、与供应商沟通;
    :⚙ 运维与门店沟通费用
    金额上限【__】有无留痕【__】;
  else (否)
  endif
  if (手机超过三年？) then (是)
    :⚙ 财务建议换新，转 IT 申请
    流程入口【__】;
    stop
  else (否)
  endif
  :⚙ 费用结算与对账
  模式（按次 / 包年）【__】
  对账周期与工作量【__】;
}
stop
@enduml
