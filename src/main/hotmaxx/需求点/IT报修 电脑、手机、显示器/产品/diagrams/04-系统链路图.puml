@startuml 04-系统链路图
!theme plain
skinparam backgroundColor #FAFAFA
skinparam defaultFontName "PingFang SC,Microsoft YaHei,Arial"
skinparam ArrowColor #607D8B
skinparam rectangleBorderColor #90A4AE
skinparam databaseBorderColor #90A4AE
skinparam packageBorderColor #90A4AE

title 门店 IT 设备报修 · 系统链路（沿用现有 AI 填报链路，不新建系统）

legend bottom left
  浅绿色底 = 本次新增
  白色底 = 现有
endlegend

actor "门店店员 / 店长" as store
actor "运维" as ops
actor "供应商\n易点租 / 小熊U租" as vendor

rectangle "hotshop App" as app {
  rectangle "服务助手 · 首页" as home
  rectangle "IT 报修 · 表单页\n（按设备类型显示字段）" as form #E8F5E9
  rectangle "AI 报修助手 · 对话页" as chat
  rectangle "我的报修 · 进度 / 报价确认 / 验收" as mine #E8F5E9
  rectangle "运维审核工作台" as desk #E8F5E9
}

cloud "公共网关" as gw
rectangle "ai-middle（Java 转发）\n解 token，注入 X-Uid" as mid
rectangle "AgentServerCenter" as agent {
  rectangle "core 框架层（不改）" as core
  rectangle "repair 报修技能包（现有）" as sk1
  rectangle "it_repair IT 报修技能包（新增）" as sk2 #E8F5E9
}
database "明道云\n报修单 + 工作流 + 状态字段" as mdy
database "PostgreSQL\n会话 / 消息归档" as pg

store --> home
home --> form
form --> chat : 点顶部 AI 入口
ops --> desk
store --> mine

form --> gw
chat --> gw
mine --> gw
desk --> gw
gw --> mid
mid --> agent
core <-- sk1
core <-- sk2
agent --> pg : 会话检查点 / 归档
agent --> mdy : 建单 / 回写状态
vendor ..> mdy : 接单 / 完成 / 报价\n（方式待定，初期可由运维代填）

note bottom of sk2
  设备类型 / 故障现象 / 照片 / 序列号 / 影响营业
  门店、联系人、电话、区域、地址自动带出
end note
note bottom of mdy
  IT 报修并入现有「门店报修」表作为大类（待确认）
  或独立表补齐状态字段
end note
@enduml
