@startuml 系统架构
!pragma layout smetana
!theme plain
skinparam backgroundColor #FAFAFA
skinparam defaultFontName "PingFang SC,Microsoft YaHei,Arial"

title 设备报修 AI 填报 — 系统架构

rectangle "客户端" #DDEEFF {
  component "App / 网页 H5 聊天页" as H5 #BBDEFB
  component "传统报修表单（存量保留）" as OLD #CFD8DC
}

rectangle "Agent 服务 · FastAPI 独立部署" #E8F5E9 {
  component "会话 API · SSE 流式" as API #C8E6C9
  component "状态机引擎" as SM #A5D6A7
  component "LangChain 编排 · LLM-XXX（待定）" as LC #C8E6C9
  component "Prompt 管理 · 版本化" as PM #DCEDC8
  component "埋点采集" as TR #DCEDC8
}

rectangle "MCP Server · 独立进程" as MCPG #ECEFF1 {
  component "get_login_profile" as T1 #B0BEC5
  component "get_store_master" as T2 #B0BEC5
  component "get_category_dict" as T3 #B0BEC5
  component "validate_photos" as T4 #B0BEC5
  component "upload_media" as T5 #B0BEC5
  component "create_repair_order" as T6 #D7CCC8
  component "draft_save / draft_get" as T7 #B0BEC5
}

rectangle "数据存储" #F5F5F5 {
  database "Redis\n会话 / 草稿 / 配额\nTTL 7 天" as RD #FFCDD2
  database "MySQL\n归档 / 埋点" as MY #CFD8DC
}

rectangle "后端服务 · MCP 数据源" #FFF9C4 {
  component "员工档案" as HR #FFE082
  component "门店主数据" as MDM #FFE082
  component "类别字典 · 配置表" as DICT #FFE082
  component "对象存储" as OSS #FFE082
}

rectangle "明道云" #FFF3E0 {
  component "明道云 API\n建单 / 工单流转" as MDY #FFCC80
}

H5 -down-> API : HTTPS + SSE
OLD ..> H5 : 草稿隔离 · 互不覆盖
API --> SM
SM --> LC
SM --> PM
LC <--> MCPG : MCP 协议
API --> TR
T1 --> HR
T2 --> MDM
T3 --> DICT
T4 --> DICT
T5 --> OSS
T6 --> MDY : 提交报修单
T7 --> RD : 会话草稿读写
TR --> MY : 埋点落库

@enduml
