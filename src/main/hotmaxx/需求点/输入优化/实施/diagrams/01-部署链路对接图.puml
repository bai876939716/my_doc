@startuml 部署链路对接图
!pragma layout smetana
!theme plain
skinparam backgroundColor #FAFAFA
skinparam defaultFontName "PingFang SC,Microsoft YaHei,Arial"
skinparam node {
  BackgroundColor #E3F2FD
  BorderColor #90A4AE
}
skinparam artifact {
  BackgroundColor #E8F5E9
  BorderColor #A5D6A7
}
skinparam database {
  BackgroundColor #FFEBEE
  BorderColor #B0BEC5
}
skinparam cloud {
  BackgroundColor #FFF3E0
  BorderColor #E0C96B
}
skinparam packageBackgroundColor #FCFCFC
skinparam packageBorderColor #B0BEC5

title 报修 Agent · 部署链路与外部对接（形态对照 ShopCadAI 实测惯例）

node "店员 App（自研）\n报修表单页 · AI 对话 H5（webview）" as APP #E3F2FD

package "K8s 集群 htm-dev（dev 示例 · prod 同构）" {
  node "Ingress（nginx）\nagent 专属域名 · 同域双路径：\n/ → agent 静态页 · /agent/** → 网关\nread-timeout 30s · body-size 50m" as ING #FFFDE7
  node "go-dev · 统一网关（Go）\n接口登记：method + path\n（common-center 审批）" as GW #FFFDE7
  node "dev · provider-biz-ai-middle（AI 中间层·已有服务）\n加转发 Controller（照 LayoutDrawingProxy 模式）\nbase-url 配置指向 agent · read-timeout 120s" as JAVA #FFF8E1
  node "python · Agent 容器\nFastAPI + LangGraph 引擎 · mcpServer 工具层\nLLM 网关模块 · web/（H5 静态页随镜像发）" as AGENT #E8F5E9
}

package "Agent 下游 · 存储组件" {
database "Redis\n检查点（thread_id=会话）\n活跃索引 · 字典缓存" as REDIS #FFEBEE
database "MySQL（RDS）\n归档 · 埋点" as MYSQL #ECEFF1
}
package "Agent 下游 · 外部服务" {
cloud "阿里云百炼 · Qwen（DashScope）\n公司 key 已有在用 · 出公网待确认同环境" as LLM #FFF3E0
cloud "明道云\n唯一服务端账号\n建单（order_key 幂等）· 字典" as MDY #FFF3E0
cloud "员工档案 / 主数据\nuid → 手机号 · 姓名" as HR #FFF3E0
cloud "OSS（阿里云）\n照片本体 · State 存 media_id" as OSS #FFF3E0
}

APP --> ING : "①② HTTPS（同域）"
ING -down-> GW : "② /agent/**（接口已登记）"
GW -down-> JAVA : "② 注入用户身份（HTM-HEADER）"
JAVA -down-> AGENT : "② 内网 base-url 直调\n（http://…-agent-svc.python:80 · 同步 JSON）"
AGENT -down-> REDIS : "⑦ 检查点 · 索引"
AGENT -down-> MYSQL : "⑦ 归档 · 埋点"
AGENT -down-> LLM : "③ 模型调用"
AGENT -down-> MDY : "④ 建单 · 字典"
AGENT -down-> HR : "⑤ 手机号带出"
AGENT -down-> OSS : "⑥ 照片直传"

note bottom of ING
  ⑧ 报修记录查询：App 已有功能走既有接口，不经 agent，不在本图
  ① 打开 H5 静态页 ② 对话 API 主链 ③ 模型调用（换型改配置）
  ④ 建单 / 字典 ⑤ 手机号带出 ⑥ 照片上传 ⑦ 存档与数据
end note
@enduml
