@startuml 部署架构图-v2
!pragma layout smetana
!theme plain
skinparam backgroundColor #FAFAFA
skinparam defaultFontName "PingFang SC,Microsoft YaHei,Arial"
skinparam node {
  BackgroundColor<<future>> #FFFFFF
  BorderColor<<future>> #B0BEC5
  BorderStyle<<future>> dashed
}
skinparam artifact {
  BackgroundColor #E8F5E9
  BorderColor #A5D6A7
}
skinparam packageBackgroundColor #FFFCF5
skinparam packageBorderColor #E0C96B

title 部署架构图 v2（对齐 2026-11-13 实现 · Redis/MySQL → PG 单库）

node "用户" as PHONE #E3F2FD {
  artifact "自研 App\n（AI 对话页 · 表单页 · 记录页）\n照片前端直传明道云" as APP
}

node "<<future>> AI 网关服务器 " as GWNODE

node "<<future>> Java 服务层\n 限流 / 排队 / 数据权限 " as JAVASRV

node "Agent 服务器 · Docker 单容器（本期唯一新建部署单元）" as AGNODE #F4FAF4 {
  artifact "agent 进程 · Python 3.13\n─────────────\n会话 API · 同步 JSON（五接口，upload 已废除）\nLangGraph 引擎 · 通用采集图（含 intake）\n技能包：报修 repair（新业务按技能包接入）\nLangChain 封装 qwen-flash\nPrompt 业务隔离 · 话术模板" as AGPROC
  artifact "mcpServer\n（暂在 agent 进程内 · 工具层解耦）\nget_user_context · get_category_dict\ncreate_repair_order\n（照片不经手：前端直传拿 URL 引用进来）" as MCPART #F7F9FA
  artifact "LLM 网关\n（暂在 agent 进程内）\n超时 · 重试 · 降级 · 计次\nOpenAI 兼容" as GWART #FFFDE7
}

database "PostgreSQL · agent 库（asc-postgres）\n─────────────\n框架三表：checkpoints / blobs / writes\n（LangGraph 检查点 · 先存再推）\n应用三表：session_archive / message_archive（永久）\nagent_active_index（重进恢复 · 7 天惰性过期）" as PGDB #FFEBEE

package "已有服务（公司现有）" {
  cloud "员工档案 / 门店主数据\n（TODO 接口确认）" as HR #FFF8E1
  cloud "类别字典 · App 表单真值\n（三大类 30 项 · 已对齐）" as DICT #FFF8E1
  cloud "对象存储 OSS" as OSS #FFF8E1
  cloud "明道云\n（唯一服务端账号 · 建单 / 工单流转 / 附件直传）" as MDY #FFF3E0
}
cloud "qwen-flash（百炼 compatible-mode）" as LLM #FFF3E0

APP --> AGPROC : HTTPS · JSON
APP --> MDY : 照片直传（serverName + key → URL）
APP ..> GWNODE : 未来统一入口
GWNODE ..> JAVASRV : 转发
JAVASRV ..> AGPROC : 限流 / 鉴权后放行
AGPROC --> MCPART : 接口直调（ToolProvider）
AGPROC --> GWART : LLM 调用
MCPART --> HR
MCPART --> DICT
MCPART --> MDY : 建单 · order_key 幂等
GWART --> LLM
AGPROC --> PGDB : 检查点（原生先存再推）\n活跃索引续期 · 终态归档

node "<<future>> mcpServer 服务器\n（第二个调用方出现时独立部署 · 引擎零改动）" as MCPNODE
MCPART ..> MCPNODE : 未来独立部署
MCPNODE ..> HR
MCPNODE ..> DICT
MCPNODE ..> MDY : 业务读写

node "<<future>> LLM 网关服务器\n（独立部署 · 多业务共享）" as LGWNODE
GWART ..> LGWNODE : 未来独立部署
LGWNODE --> LLM : 模型调用

note right of PGDB
  v1 架构图中 Redis 与 MySQL 两节点作废：
  存储整体并入 PG 单库（2026-11-12/13），
  Redis 相关组件全部清除。
end note
@enduml
