@startuml
!theme plain
skinparam backgroundColor #FAFAFA
skinparam defaultFontName Microsoft YaHei
skinparam componentStyle rectangle
skinparam ArrowColor #555555
skinparam PackageBorderColor #999999
skinparam ComponentBorderColor #AAAAAA
skinparam NoteBackgroundColor #FFFDE7
skinparam NoteBorderColor #CCCCCC

title 大模型微调专有名词 — 三个维度关系图

'══════════════════════════════════════════════
' 维度一：训练阶段（做什么，按顺序）
'══════════════════════════════════════════════
package "维度一  训练阶段  顺序执行" #FFF9C4 {

  component "预训练  Pre-training\n海量无标注文本\n产出 Base 模型  只会续写" as PRE

  component "持续预训练  CPT  可选\n无标注的领域文本\n产出 领域 Base 模型" as CPT

  component "SFT  指令微调\n指令 + 期望输出\n产出 Chat / Instruct 模型" as SFT

  component "RLHF\n三步：SFT -> 训奖励模型 -> PPO\n对齐效果好  流程复杂" as RLHF

  component "DPO\n直接用偏好对训练\nRLHF 的简化版  更稳定省资源" as DPO

  PRE  -down-> CPT  : 可选
  CPT  -down-> SFT
  SFT  -down-> RLHF : 二选一
  SFT  -down-> DPO  : 二选一
}

note right of PRE
  这一步只能全量微调
  从随机初始值开始
  需要超大规模算力
end note

note right of RLHF
  RLHF 内部子组件：
  奖励模型 RM  负责打分
  PPO  强化学习算法
  两者是 RLHF 的组成部分
  不是独立的训练阶段
end note

'══════════════════════════════════════════════
' 维度二：参数更新方式（怎么改，与维度一正交）
'══════════════════════════════════════════════
package "维度二  参数更新方式  与维度一正交  可自由组合" #DDEEFF {

  component "全量微调  Full Fine-tuning\n所有参数全部更新\n效果上限最高  显存要求最高" as FULL

  package "PEFT  参数高效微调  统称" #E8F4FD {
    component "LoRA\n只训两个低秩小矩阵\n最常用的 PEFT 方法" as LORA
    component "QLoRA\nLoRA + 4-bit 量化\n消费级显卡也能跑大模型" as QLORA
    component "Prefix Tuning\n只训输入前的软提示\n效果差  现在少用了" as PREFIX
  }
}

note right of LORA
  维度一 x 维度二 自由组合：
  SFT  + LoRA    最常用的工程选择
  DPO  + LoRA    对齐阶段省资源
  SFT  + 全量    有充足多卡时
  RLHF + 全量    ChatGPT 的做法
end note

'══════════════════════════════════════════════
' 维度三：知识来源（从哪补知识，独立决策）
'══════════════════════════════════════════════
package "维度三  知识来源  独立决策" #E8F5E9 {

  component "微调  Fine-tuning\n改模型参数  永久记住\n适合改行为  风格  推理能力" as FT_K

  component "RAG  检索增强生成\n推理时检索文档  不改参数\n适合知识会变  需要引用来源" as RAG_K

  component "上下文学习  ICL\nPrompt 里直接放示例\n零成本  但不持久" as ICL_K

  FT_K -right[hidden]- RAG_K
  RAG_K -right[hidden]- ICL_K
}

note right of RAG_K
  三者不互斥：
  微调  改行为和风格
  RAG   补会变的知识
  ICL   临时调整格式
  实际项目经常同时用微调 + RAG
end note

@enduml
