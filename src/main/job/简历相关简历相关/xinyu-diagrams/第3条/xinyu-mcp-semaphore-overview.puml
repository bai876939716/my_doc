@startuml
!theme plain
skinparam backgroundColor #FAFAFA
skinparam defaultFontName Microsoft YaHei
skinparam componentStyle rectangle
skinparam packageBorderColor #888888
skinparam noteBorderColor #AAAAAA
skinparam ArrowColor #666666
skinparam ComponentBorderColor #888888
skinparam DatabaseBorderColor #888888
skinparam QueueBorderColor #888888

title LangGraph Agent 工作流 + MCP 工具集成 全貌\n（5 类业务场景 · 任务分发 · 全链路并发控制）

'─────────────────────────────────────────
' 第一层：5 类业务入口
'─────────────────────────────────────────
package "5 类业务场景 — 各设独立 Agent" #FFF9C4 {
  component "陌生角色 Feed\n（实时，用户浏览新角色）" as F1
  component "熟人 Feed\n（实时，已互动角色推送）" as F2
  component "星梦批量生产\n（离线，XXL-Job 06:00 触发）" as F3 #FFE0B2
  component "开场白改写\n（实时，对话前触发）" as F4
  component "意图识别\n（实时，对话意图分类）" as F5
}

'─────────────────────────────────────────
' 批量任务分发链（仅 F3 走此路径）
'─────────────────────────────────────────
queue "RocketMQ\n（At-Least-Once）" as MQ #FFE0B2

package "Java Consumer 线程池 ← 并发调节阀" #FFF3E0 {
  component "Thread-1~C\nHTTP POST AgentRun\n同步阻塞等待完成" as Consumer
}

note right of Consumer
  Consumer 线程数 C = 实际并发 AgentRun 数
  是整个批量链路吞吐的调节阀
  实时任务（F1/F2/F4/F5）直接 HTTP 调用
end note

'─────────────────────────────────────────
' 第三层：AgentRun Serverless 平台
'─────────────────────────────────────────
cloud "阿里云 AgentRun Serverless\nbatch: instanceConcurrency=10 / 2vCPU · 4GB  |  realtime: instanceConcurrency=100 / 1vCPU · 2GB" as Platform {

  package "实例 1（同时处理 ≤10 个任务）" #E8F4FD {
    component "LangGraph Agent ×10\nStateGraph + add_conditional_edges\n节点写 error → 条件边短路 END" as A1  #FFFFFF

    component "McpClient 单例\n_TOOL_ROUTING（25+ 工具名→服务名）\nAgent 只传工具名，路由透明" as MC1  #FFFDE7

    component "LLM Semaphore\nlimit=8\n每批次 gather_bounded 新建\n批次完成后销毁" as LS1  #C8E6C9

    component "MCP Semaphore\nlimit=8\n实例内全局单例\nPhase1~5 所有调用共用" as MS1  #FFF9C4

    A1 -right-> LS1 : LLM 调用
    A1 -down-> MC1 : _invoke(tool_name, args)
    MC1 -right-> MS1 : acquire()
  }

  package "实例 2（同时处理 ≤10 个任务）" #E8F4FD {
    component "LangGraph Agent ×10" as A2  #FFFFFF
    component "McpClient 单例" as MC2  #FFFDE7
    component "LLM Semaphore\nlimit=8" as LS2  #C8E6C9
    component "MCP Semaphore\nlimit=8" as MS2  #FFF9C4
    A2 -right-> LS2
    A2 -down-> MC2
    MC2 -right-> MS2
  }

  package "实例 N\n（N = ceil(C ÷ 10)）" #E8F4FD {
    component "LangGraph Agent ×10" as AN  #FFFFFF
    component "McpClient 单例" as MCN  #FFFDE7
    component "LLM Semaphore\nlimit=8" as LSN  #C8E6C9
    component "MCP Semaphore\nlimit=8" as MSN  #FFF9C4
    AN -right-> LSN
    AN -down-> MCN
    MCN -right-> MSN
  }

  note as NoteInst
    场景示例：实例1 处理 小明的星梦批量生产（Phase 3，20 个任务）

    LLM Semaphore — 每批次新建，防内存溢出：
    ┌─────────────────────────────────────────────┐
    │ Task 1~8  → acquire() 成功，同时执行         │
    │ Task 9~20 → acquire() 失败，协程挂起         │
    │              0 CPU · 内存仅协程栈帧（字节级） │
    │ Task1 完成 → release() → Task9 立即唤醒      │
    │ 内存中始终 ≤ 8 份 Prompt + 响应缓冲          │
    └─────────────────────────────────────────────┘

    MCP Semaphore — 实例内全局单例，防 Java 连接池耗尽：
    ┌─────────────────────────────────────────────┐
    │ Phase1/2/3/4/5 所有 MCP 调用共用令牌池(8)    │
    │ 该实例任意时刻 ≤ 8 路 HTTP 打向 Java         │
    └─────────────────────────────────────────────┘

    实例间完全隔离：各自独立计数，不共享 Semaphore
  end note
}

'─────────────────────────────────────────
' 第四层：外部服务
'─────────────────────────────────────────
cloud "外部服务" {
  component "LLM API\n(DeepSeek-Flash / Qwen3-Max)" as LLM  #BBDEFB
  component "Java MCP Servers\n× 6 服务集群\ndream / user / profile\nshort / soul-user / core" as JavaMCP  #FFCDD2
}

'─────────────────────────────────────────
' 连接关系
'─────────────────────────────────────────
F1 -down-> Platform : HTTP（实时直调）
F2 -down-> Platform
F4 -down-> Platform
F5 -down-> Platform

F3 -down-> MQ : 批量入队
MQ -down-> Consumer
Consumer -down-> Platform : C 个并发 HTTP

LS1 -down-> LLM : ≤8 路
LS2 -down-> LLM : ≤8 路
LSN -down-> LLM : ≤8 路

MS1 -down-> JavaMCP : ≤8 路
MS2 -down-> JavaMCP : ≤8 路
MSN -down-> JavaMCP : ≤8 路

note bottom of LLM
  LLM 总并发 = 实例数 N × 8
  各实例 LLM Semaphore 独立计数
  超出 API QPS → 429 → 指数退避重试
end note

note bottom of JavaMCP
  MCP 总并发 = 实例数 N × 8
  ──────────────────────────────────
  C=50  → N=5  → MCP=40  路 → ~10h
  C=200 → N=20 → MCP=160 路 → ~2.5h
  C=500 → N=50 → MCP=400 路 → ~1h
  ──────────────────────────────────
  Java 连接池上限需 ≥ N × 8
  MCP Semaphore 保证单实例 ≤8 路，
  避免单实例瞬间打爆 Java 连接池
end note

@enduml
