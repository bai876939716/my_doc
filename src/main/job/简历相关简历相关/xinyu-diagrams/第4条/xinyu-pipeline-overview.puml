@startuml
!theme plain
skinparam backgroundColor #FAFAFA
skinparam defaultFontName Microsoft YaHei
skinparam ArrowColor #555555
skinparam ActivityBorderColor #888888
skinparam ActivityBackgroundColor #FFFFFF
skinparam NoteBackgroundColor #FFFDE7
skinparam NoteBorderColor #AAAAAA
skinparam PartitionBorderColor #888888

title 五阶段星梦批处理流水线\n场景：小明（林诗雨 Lv1->Lv2 / 陆承宇 Lv3 / 苏凛 Lv5）

start

:XXL-Job 06:00 触发
Java Handler 扫描活跃用户
每用户发 RocketMQ 消息
Consumer 线程消费 -> HTTP POST AgentRun
Python 实例（小明）启动;

note right
  RocketMQ 仅作缓冲层
  Consumer 线程数 C 控制真实并发
  每个用户对应独立 Python 实例
end note

partition "Phase 1  扫描升级角色（无 LLM，0 Token）" {
  :MCP queryUpgradePendingRoles
  -> 林诗雨 Lv1->Lv2;
  :MCP markOldDreamsConsumed
  -> 清除林诗雨 Lv1 旧库存 5 条;
}

note right: 纯 MCP 调用，无 LLM\n扫描到升级角色才触发后续改写

partition "Phase 2  批量改写旧内容" {
  :gather_bounded( 5 条改写任务 )
  并发改写林诗雨 Lv2 星梦措辞;
}

note right: 改写 < 全量重生成，Token 消耗更小

partition "Phase 3  时间窗缺口分析 + 库存优先生产" {
  :分析 12 个时间窗，发现缺口 20 条;

  repeat
    if (当前时间窗有库存？) then (是  约60%)
      :直接复用现有内容\n0 Token 消耗;
    else (否  约40%)
      :调用 LLM 生产新内容\n受 LLM Semaphore 限流 <=8;
    endif
    :写入库存（MCP 调用）;
  repeat while (还有缺口任务？) is (有)
  ->无;
}

note right
  库存优先策略效果：
  约 60% 内容直接复用，0 Token
  约 40% 内容调 LLM 生产
  整体 Token 成本降低约 40%
  20 条任务 = 约 12 条复用 + 8 条新生
end note

partition "Phase 4  Lv3+ 全量覆盖补漏" {
  :检查陆承宇（Lv3）12 个时间窗覆盖情况;
  if (有覆盖缺口？) then (是)
    :gather_bounded( 2 条 )\n补生产 W07、W08 各 1 条;
  else (否)
    :跳过;
  endif
}

note right: Lv3+ 用户保障全时间窗覆盖

partition "Phase 5  星事钩子补充" {
  :检查苏凛（Lv5）近期星事缺口;
  if (有星事缺口？) then (是)
    :生产星事内容（特殊事件钩子）;
  else (否)
    :跳过（本次无缺口）;
  endif
}

:返回汇总结果
phase1_upgraded:  1（林诗雨）
phase2_rewritten: 5
phase3_produced:  20（12复用+8新生）
phase4_coverage:  2（陆承宇 W07、W08）
phase5_star:      0
total_elapsed: ~180s;

stop

note right
  失败重试机制：
  RocketMQ At-Least-Once 保证消息不丢
  Redis SET NX（key=batch:uid:date）保幂等
  Consumer 重启后消息重投，不重复执行
end note

@enduml
